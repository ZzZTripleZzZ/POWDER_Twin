FROM ubuntu:24.04 AS tt-gnb

ARG NEEDED_GIT_PROXY
ARG TARGETARCH
ARG BUILD_OPTION
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris
# ENV BUILD_UHD_FROM_SOURCE=True
# ENV UHD_VERSION=4.4.0.0

# POWDER nodes occasionally fail DNS resolution for the default Ubuntu mirrors
# from inside Docker builds. Use a mirror that is reachable from Emulab.
RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.edge.kernel.org/ubuntu/|g' \
        -e 's|http://security.ubuntu.com/ubuntu/|http://mirrors.edge.kernel.org/ubuntu/|g' \
        /etc/apt/sources.list.d/ubuntu.sources

#install developers pkg/repo
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        #gcc needed for build_oai
        cmake \
        ninja-build \
        build-essential \
        psmisc \
        git \
        #use gcc-12 to avoid problems of default gcc-11 in FlexRIC
        gcc-12 \
        g++-12 \
        xxd \
        libyaml-cpp-dev \
        libpcre2-dev \
        python3-dev \
        bison \
        flex \
        m4 \
        libforms-dev \
        # python3-pip for conf template generation
        python3-pip && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 --slave /usr/bin/g++ g++ /usr/bin/g++-12 
    #pip3 install --ignore-installed pyyaml

# Add "Tini - A tiny but valid init for containers", https://github.com/krallin/tini
# it will be copied into target containers, to print exit numbers and handle signals properly
ENV TINI_VERSION=v0.19.0
ADD https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-${TARGETARCH} /tini
RUN chmod +x /tini

# In some network environments, GIT proxy is required
RUN /bin/bash -c "if [[ -v NEEDED_GIT_PROXY ]]; then git config --global http.proxy $NEEDED_GIT_PROXY; fi"

# # Copying only the needed files to create ran-base
# WORKDIR /oai-ran/cmake_targets/tools
# COPY cmake_targets/tools/build_helper \
#      cmake_targets/tools/uhd-4.x-tdd-patch.diff \
#      ./

# WORKDIR /oai-ran/cmake_targets
# COPY cmake_targets/build_oai .

# WORKDIR /oai-ran
# COPY oaienv .

# #run build_oai -I to get the builder image
# RUN /bin/sh oaienv && \ 
#     cd cmake_targets && \
#     mkdir -p log && \
#     ./build_oai -I -w USRP --install-optional-packages

# RUN rm -Rf /oai-ran
WORKDIR /tt-ran
COPY . .
    
RUN apt-get update && apt-get install -y \
    libyaml-cpp-dev

	
RUN apt-get update
RUN apt-get install -y libgtest-dev
RUN apt-get install -y libzmq3-dev
RUN apt-get install -y protobuf-compiler libprotobuf-dev
    
# CMAKE_PREFIX_PATH must include /usr so find_package(UHD) locates
# UHDConfig.cmake at /usr/lib/x86_64-linux-gnu/cmake/uhd/. UHD_DIR is
# read by UHDConfig.cmake itself (`set(UHD_DIR $ENV{UHD_DIR})`) and
# adds /usr/include + /usr/lib to its HINTS — find_library then walks
# the multiarch arch-triple path (/usr/lib/x86_64-linux-gnu) and locates
# libuhd.so. Without this, on Ubuntu 24.04 noble (UHD 4.6.0+) the
# UHDConfig.cmake at line 90 calls get_filename_component on an empty
# UHD_LIBRARIES and dies with "incorrect number of arguments".
ENV CMAKE_PREFIX_PATH=/usr:/usr/local:/usr/include/yaml-cpp
ENV UHD_DIR=/usr
ENV CMAKE_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu
ENV CMAKE_INCLUDE_PATH=/usr/include

# build all targets so final targets can be created afterwards
# RUN /bin/sh oaienv && \
#     cd cmake_targets && \
#     mkdir -p log && \
#     ./build_oai -C && \
#     ./build_oai -I -w SIMU \
#         --gNB --nrUE \
#         --build-lib "telnetsrv enbscope uescope nrscope" \
#         --cmake-opt -DXAPP_MULTILANGUAGE=OFF --cmake-opt -DKPM_VERSION=$KPM_VERSION --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
#         --cmake-opt -DCMAKE_C_FLAGS="-w" --cmake-opt -DCMAKE_CXX_FLAGS="-w" $BUILD_OPTION && \
#     #     #--cmake-opt -DCMAKE_C_FLAGS="-Werror" --cmake-opt -DCMAKE_CXX_FLAGS="-Werror" $BUILD_OPTION && \
#     # Mainly to see if the sanitize option was perfectly executed
#     echo "---- ldd on executables ----" && \
#     ldd ran_build/build/*softmodem* ran_build/build/nr-cuup && \
#     # ran_build/build/oairu && \
#     echo "---- ldd on shared libraries ----" && \
#     ldd ran_build/build/*.so
    
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        software-properties-common \
        procps \
        libsctp1 \
        libboost-chrono1.74.0 \
        libboost-date-time1.74.0 \
        libboost-filesystem1.74.0 \
        libboost-regex1.74.0 \
        libboost-serialization1.74.0 \
        libboost-thread1.74.0 \
        libboost-system1.74.0 \
        libboost-program-options1.74.0 \
        tzdata \
        libblas3 \
        libconfig9 \
        openssl \
        net-tools \
        iperf \
        iperf3 \
        iproute2 \
        iputils-ping \
        gdb \
        python3 \
        python3-six \
        python3-requests \
        libusb-1.0-0 \
        libyaml-cpp-dev \
        uhd-host \
        libuhd-dev && \
    # if the --sanitize option was used to build, additional packages are required
    /bin/bash -c 'if [[ "$BUILD_OPTION" = "--sanitize" ]]; then DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        #libasan5 \ # see below
        libubsan1 \
        liblapacke; fi' && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

# Make libuhd-dev's CMake config visible to find_package(UHD), but
# REPLACE the broken UHDConfig.cmake with a minimal hand-written one.
#
# Why: noble's UHDConfig.cmake unconditionally calls
#   get_filename_component(UHD_LIB_PATH ${UHD_LIBRARIES} PATH)
# right after find_library. OAI's build_oai strips ENV (UHD_DIR,
# CMAKE_LIBRARY_PATH, etc) before calling cmake, so UHD_LIBRARIES ends
# up empty even though libuhd.so is installed at the multiarch path,
# and the get_filename_component call dies with "incorrect number of
# arguments" at line 90.
#
# The clean workaround is to skip the find_library logic entirely and
# hardcode the noble paths (we control the base image so we know they
# are stable: /usr/include and /usr/lib/x86_64-linux-gnu/libuhd.so).
# Stage UHD headers in a non-system path so CMake's
# target_include_directories actually emits a -I flag. CMake silently
# strips entries that match the compiler's default system search list
# (/usr/include is one of those), so even with UHD_INCLUDE_DIRS set
# correctly the compile saw no -I and the build broke at
# `#include <uhd/version.hpp>`. Symlink the package's uhd/ tree under
# /opt/uhd-include/uhd/ and point the shim at /opt/uhd-include.
RUN mkdir -p /usr/lib/cmake/UHD /opt/uhd-include && \
    cp -a /usr/lib/x86_64-linux-gnu/cmake/uhd/. /usr/lib/cmake/UHD/ && \
    test -f /usr/lib/x86_64-linux-gnu/libuhd.so && \
    ln -sfn /usr/include/uhd /opt/uhd-include/uhd && \
    test -f /opt/uhd-include/uhd/version.hpp && \
    printf '%s\n' \
        '# dt_sync replacement UHDConfig.cmake - skips libuhd-dev (4.6.0)' \
        '# find_library + get_filename_component logic which fails under' \
        "# OAI's build_oai (env-stripping wrapper). Hardcodes noble paths." \
        'list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")' \
        'set(ENV{UHD_CONFIG_USED} TRUE)' \
        'set(UHD_INCLUDE_DIRS  "/opt/uhd-include" CACHE PATH "UHD include dir" FORCE)' \
        'set(UHD_LIBRARIES     "/usr/lib/x86_64-linux-gnu/libuhd.so" CACHE FILEPATH "UHD library" FORCE)' \
        'set(UHD_FOUND         TRUE  CACHE BOOL "" FORCE)' \
        'set(UHD_RFNOC_FOUND   TRUE  CACHE BOOL "" FORCE)' \
        'include(FindPackageHandleStandardArgs)' \
        'FIND_PACKAGE_HANDLE_STANDARD_ARGS(UHD DEFAULT_MSG UHD_LIBRARIES UHD_INCLUDE_DIRS)' \
        'mark_as_advanced(UHD_LIBRARIES UHD_INCLUDE_DIRS)' \
        'message(STATUS "dt_sync UHD shim: UHD_INCLUDE_DIRS=${UHD_INCLUDE_DIRS} UHD_LIBRARIES=${UHD_LIBRARIES}")' \
        > /usr/lib/cmake/UHD/UHDConfig.cmake && \
    cat /usr/lib/cmake/UHD/UHDConfig.cmake

# Patch OAI's USRP CMakeLists.txt: the original `find_package(UHD REQUIRED UHD)`
# treats the trailing 'UHD' as a required component, which trips UHDConfig.cmake
# internal validator with "get_filename_component called with incorrect number
# of arguments" (line 90). Drop the redundant component so find_package uses
# the standard single-argument REQUIRED form.
RUN sed -i 's/find_package(UHD REQUIRED UHD)/find_package(UHD REQUIRED)/g' \
        radio/USRP/CMakeLists.txt && \
    grep "find_package(UHD" radio/USRP/CMakeLists.txt && \
    \
    # Hardcode the include path on the oai_usrpdevif target. CMake's \
    # target_include_directories silently filters paths that match the \
    # compiler's implicit system search list - even our /opt/uhd-include \
    # staging didn't survive somehow. Append a literal hardcoded path \
    # via target_compile_options(... -I...) which CMake passes through \
    # untouched. \
    grep -q '/opt/uhd-include' radio/USRP/CMakeLists.txt || \
    sed -i '/^target_include_directories(oai_usrpdevif/a\target_compile_options(oai_usrpdevif PRIVATE -I/opt/uhd-include)' \
        radio/USRP/CMakeLists.txt && \
    grep -E 'target_(include_directories|compile_options).*oai_usrpdevif' radio/USRP/CMakeLists.txt

# WORKDIR /opt/oai-gnb/bin
# COPY --from=gnb-build \
#     /oai-ran/cmake_targets/ran_build/build/nr-softmodem ./
# COPY ./docker/scripts/gnb_entrypoint.sh ./entrypoint.sh

# RUN /bin/bash -c "ln -s /usr/local/lib/liboai_usrpdevif.so /usr/local/lib/liboai_device.so" && \
#     ldconfig && \
#     echo "---- ldd on nr-softmodem ----" && \
#     ldd /opt/oai-gnb/bin/nr-softmodem && \
#     echo "---- ldd on shared libraries ----" && \
#     ldd /usr/local/lib/liboai_eth_transpro.so \
#         /usr/local/lib/librfsimulator.so \
#         /usr/local/lib/liboai_usrpdevif.so \
#         /usr/local/lib/libcoding.so \
#         /usr/local/lib/libparams_libconfig.so \
#         /usr/local/lib/libdfts.so \
#         /usr/local/lib/libldpc*.so \
#         /usr/local/lib/libtelnetsrv.so \
#         /usr/local/lib/libtelnetsrv_ci.so \
#         /usr/local/lib/libuhd.so.4.4.0
# Patch OAI build_helper for Ubuntu 24.04: python-tk -> python3-tk (no longer in noble repos)
RUN sed -i 's/python-tk/python3-tk/g' cmake_targets/tools/build_helper

# Patch EdgeRIC's hardcoded ZMQ publisher bind address. The C++ source binds
# to tcp://192.168.70.140:5555 unconditionally; in docker bridge mode (twin)
# the container has .140 statically assigned and the bind succeeds, but in
# network_mode: host (gnb-real OTA), .140 is added as a host alias by
# real_twin_eval.py, AND the bind here must accept the host's other
# interfaces too so the twin can subscribe via gnb-real's ctrl-lan IP.
# Replace 192.168.70.140 with 0.0.0.0 so ZMQ listens on all interfaces.
RUN if [ -f executables/edgeric/edgeric.cpp ]; then \
      sed -i 's|tcp://192.168.70.140:5555|tcp://0.0.0.0:5555|g' executables/edgeric/edgeric.cpp && \
      grep -E 'publisher\.bind|0\.0\.0\.0:5555' executables/edgeric/edgeric.cpp | head -3; \
    else \
      echo "(no executables/edgeric/edgeric.cpp - skipping bind patch)"; \
    fi

# find_package(UHD) is satisfied by ENV CMAKE_PREFIX_PATH=/usr (set above)
# pointing CMake at /usr/lib/x86_64-linux-gnu/cmake/uhd/UHDConfig.cmake from
# libuhd-dev. The UHD header path is injected via target_compile_options on
# oai_usrpdevif (line ~222) — do NOT also pass -I via --cmake-opt because
# build_oai strips the quotes around the multi-word value and CMake then sees
# `-I/opt/uhd-include` as a top-level CLI arg and aborts with
# "Unknown argument -I/opt/uhd-include". Use ENV instead if a global include
# path is ever needed.
ENV CFLAGS="-I/opt/uhd-include"
ENV CXXFLAGS="-I/opt/uhd-include"
RUN /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    ./build_oai -C && \
    ./build_oai -I -w USRP \
        --gNB --nrUE \
        --build-lib "telnetsrv enbscope uescope nrscope" \
        --cmake-opt -DXAPP_MULTILANGUAGE=OFF --cmake-opt -DKPM_VERSION=$KPM_VERSION --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
        --cmake-opt -DCMAKE_C_FLAGS=-w --cmake-opt -DCMAKE_CXX_FLAGS=-w $BUILD_OPTION && \
    ln -sf /usr/local/lib/liboai_usrpdevif.so /usr/local/lib/liboai_device.so && \
    ldconfig && \
    echo "---- ldd on executables ----" && \
    ldd ran_build/build/*softmodem* && \
    echo "---- ldd on shared libraries ----" && \
    ldd ran_build/build/*.so
WORKDIR /opt/tt-ran/tt
# COPY --from=gnb-build \
#     /oai-ran/cmake_targets/ran_build/build/nr-softmodem ./
# COPY ./docker/scripts/gnb_entrypoint.sh ./entrypoint.sh

